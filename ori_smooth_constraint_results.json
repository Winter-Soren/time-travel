    "angular_remapping_python": "import numpy as np\nfrom disk_basis import _modes\nold=dict(zip(_modes(old_degree,old_cap),old_coeff.reshape(-1,4)))\nnew_coeff=np.array([old.get(mode,np.zeros(4)) for mode in _modes(new_degree,new_cap)]).ravel()",
    "saved_case_validation_python": "import numpy as np\nfrom disk_basis import _modes\nfrom ori_disk_constraints import validate_solution, projected_constraint_check\nwith np.load('ori_smooth_constraint_coefficients.npz') as f:\n    c=f['strong_coefficients']; d=int(f['strong_degree']); m=int(f['strong_max_angular'])\nprint(validate_solution(d,1.,c,radius=3.,source_radius=1.,max_angular=m,taper_kind='smooth')[0])\nold=dict(zip(_modes(d,m),c.reshape(-1,4)))\nfor angular,padding in [(16,8),(12,16)]:\n    expanded=np.array([old.get(mode,np.zeros(4)) for mode in _modes(d,angular)]).ravel()\n    print(projected_constraint_check(d,1.,expanded,padding=padding,radius=3.,source_radius=1.,max_angular=angular,taper_kind='smooth',batch_size=512))\n",
    "fresh_cloud_python": "import json\nimport numpy as np\nfrom ori_disk_constraints import seed_data, scaled_basis, residual\nwith np.load('ori_smooth_constraint_coefficients.npz') as f:\n    degree=int(f['strong_degree']); cap=int(f['strong_max_angular']); coeff=f['strong_coefficients'].copy()\nassert degree==440 and cap==12\ntheta=np.r_[np.arange(4)*np.pi/2,(np.arange(41)+.2718)*2*np.pi/41]\nradii=np.unique(np.r_[np.linspace(0,3,301),3-10.**np.linspace(-8,-2,13),np.linspace(2.97,3,61),1-10.**np.linspace(-8,-1,15),1+10.**np.linspace(-8,-1,15)])\nx=(radii[:,None]*np.cos(theta)).ravel(); y=(radii[:,None]*np.sin(theta)).ravel()\nrng=np.random.default_rng(720481); rr=3*np.sqrt(rng.random(1733)); aa=rng.uniform(0,2*np.pi,1733)\nx=np.r_[x,rr*np.cos(aa)]; y=np.r_[y,rr*np.sin(aa)]\nfresh={'points':len(x),'max_H':0.,'max_M':0.,'square_half_width':2.1,'square_max_H':0.,'square_max_M':0.,'min_psi':float('inf'),'random_seed':720481}\nfor start in range(0,len(x),512):\n    xx=x[start:start+512]; yy=y[start:start+512]\n    data=seed_data(xx,yy,1.,source_radius=1.,taper_kind='smooth')\n    mats=scaled_basis(degree,xx,yy,3.,max_angular=cap,compact=True)\n    actual,H,M=residual(data,mats,coeff,physical=True,pointwise=True)\n    for key,samples in [('max_H',abs(H)),('max_M',M)]:\n        if actual[key]>fresh[key]:\n            j=int(np.argmax(samples)); fresh[key]=actual[key]; fresh[key+'_location']=[float(xx[j]),float(yy[j])]\n    fresh['min_psi']=min(fresh['min_psi'],actual['min_psi'])\n    mask=(abs(xx)<=2.1)&(abs(yy)<=2.1)\n    if mask.any():\n        fresh['square_max_H']=max(fresh['square_max_H'],float(np.max(abs(H[mask]))))\n        fresh['square_max_M']=max(fresh['square_max_M'],float(np.max(M[mask])))\nassert fresh['points']==19508 and max(fresh['max_H'],fresh['max_M'])<1e-7\nprint(json.dumps(fresh))\n"
